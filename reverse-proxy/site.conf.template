server {
	listen ${PORT};
	server_name ${STATIC_SUBDOMAIN}.${DOMAIN};

	location / {
		proxy_set_header   X-Forwarded-For $remote_addr;
    proxy_set_header   Host $http_host;
    proxy_pass         "http://${IP}:${STATIC_PORT}";
	}
}

server {
	listen ${PORT};
	server_name ${MEDIA_SUBDOMAIN}.${DOMAIN};

	location / {
		proxy_set_header   X-Forwarded-For $remote_addr;
    proxy_set_header   Host $http_host;
    proxy_pass         "http://${IP}:${MEDIA_PORT}";
	}
}

server {
	listen ${PORT};
	server_name ${DOMAIN};

	location / {
    proxy_set_header   X-Forwarded-For $remote_addr;
    proxy_set_header   Host $http_host;
    proxy_pass         "http://${IP}:${BLOG_PORT}";
  }
}

